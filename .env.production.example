APP_NAME=ResearchHub-U
APP_ENV=production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1
RESEARCH_OS_URL=https://research-os.example.edu.co
CRIS_URL=https://cris.example.edu.co
CRAI_URL=https://crai.ucompensar.edu.co/
RESEARCH_BLOG_URL=
DOCS_ENABLED=false
ALLOWED_HOSTS=researchhub.example.edu.co
CORS_ORIGINS=https://researchhub.example.edu.co
SECURITY_HSTS_ENABLED=true

POSTGRES_DB=researchhub_u
POSTGRES_USER=researchhub_user
POSTGRES_PASSWORD=REPLACE_WITH_SECRET_MANAGER_VALUE
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+pg8000://researchhub_user:REPLACE_WITH_SECRET_MANAGER_VALUE@db:5432/researchhub_u
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800

SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=researchhub-u
JWT_AUDIENCE=researchhub-u-web
LOG_LEVEL=INFO
WEB_CONCURRENCY=2
FORWARDED_ALLOW_IPS=REPLACE_WITH_TRUSTED_INGRESS_IP

SELF_REGISTRATION_ENABLED=false
BOOTSTRAP_SUPERADMIN_ENABLED=false
BOOTSTRAP_SUPERADMIN_NAME=
BOOTSTRAP_SUPERADMIN_EMAIL=
BOOTSTRAP_SUPERADMIN_PASSWORD=
