APP_NAME=ResearchHUB
APP_ENV=local
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1
RESEARCH_OS_URL=
CRIS_URL=
CRAI_URL=https://crai.ucompensar.edu.co/
RESEARCH_BLOG_URL=
SERVICES_MARKETPLACE_URL=
DOCS_ENABLED=true
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CORS_ORIGINS=
SECURITY_HSTS_ENABLED=false

POSTGRES_DB=researchhub_u
POSTGRES_USER=researchhub_user
POSTGRES_PASSWORD=local_development_only_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+pg8000://researchhub_user:local_development_only_password@db:5432/researchhub_u
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800

SECRET_KEY=local_development_only_secret_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=researchhub-u
JWT_AUDIENCE=researchhub-u-web
LOG_LEVEL=INFO

SELF_REGISTRATION_ENABLED=false
BOOTSTRAP_SUPERADMIN_ENABLED=false
BOOTSTRAP_SUPERADMIN_NAME=
BOOTSTRAP_SUPERADMIN_EMAIL=
BOOTSTRAP_SUPERADMIN_PASSWORD=
